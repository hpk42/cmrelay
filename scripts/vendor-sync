#!/usr/bin/env python3
"""Refresh vendor/, vendor.lock and nix/generated/relay-pins.json from the submodule.

vendor/ is generated output and is never hand edited; local deltas belong in
patches/. Run this after moving the cmdeploy-relay submodule.
"""

import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO / "src"))

from cmrelay.vendoring import VendorError, refresh  # noqa: E402


def main():
    try:
        count = refresh(REPO, REPO / "cmdeploy-relay", REPO)
    except VendorError as exc:
        print(f"vendor-sync: {exc}", file=sys.stderr)
        return 1
    print(f"vendor-sync: {count} files vendored")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
