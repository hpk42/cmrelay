#!/usr/bin/env python3
"""Copy relay's declarative surface into vendor/ and refresh vendor.lock.

vendor/ is generated output and is never hand edited. Local deltas belong in
patches/, applied after the copy, so at any moment it is obvious which bytes
came from relay and which are ours.
"""

import argparse
import json
import subprocess
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO / "src"))

from cmrelay.vendoring import Mapping, VendorError, sha256_file, sync  # noqa: E402


def git(relay_root, *args):
    return subprocess.run(
        ["git", "-C", str(relay_root), *args],
        capture_output=True,
        text=True,
        check=True,
    ).stdout.strip()


def apply_patches(repo: Path) -> list[str]:
    series = repo / "patches" / "series"
    if not series.is_file():
        return []
    applied = []
    for line in series.read_text().splitlines():
        name = line.split("#", 1)[0].strip()
        if not name:
            continue
        subprocess.run(
            ["patch", "-p1", "--quiet", "-i", str(repo / "patches" / name)],
            cwd=repo / "vendor",
            check=True,
        )
        applied.append(name)
    return applied


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "relay_root",
        nargs="?",
        default=REPO / "cmdeploy-relay",
        type=Path,
        help="path to a relay checkout (default: the cmdeploy-relay submodule)",
    )
    args = parser.parse_args(argv)

    mapping = Mapping.load(REPO / "vendor.toml")
    try:
        hashes = sync(args.relay_root, REPO / "vendor", mapping)
    except VendorError as exc:
        print(f"vendor-sync: {exc}", file=sys.stderr)
        return 1

    patches = apply_patches(REPO)
    if patches:
        for dest in hashes:
            hashes[dest] = sha256_file(REPO / "vendor" / dest)

    lock = {
        "relay_url": mapping.relay_url,
        "relay_commit": git(args.relay_root, "rev-parse", "HEAD"),
        "relay_describe": git(
            args.relay_root, "describe", "--tags", "--always", "--dirty"
        ),
        "patches": patches,
        "files": hashes,
    }
    (REPO / "vendor.lock").write_text(json.dumps(lock, indent=2, sort_keys=True) + "\n")
    print(
        f"vendored {len(hashes)} files from relay {lock['relay_commit'][:12]}"
        f" ({len(patches)} patch(es) applied)"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
