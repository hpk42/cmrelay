#!/usr/bin/env python3
"""Print relay's port table and pinned binaries as JSON.

The build reads this to generate nix/generated/relay-pins.json. See
cmrelay.relayextract for why it parses rather than imports.
"""

import argparse
import json
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO / "src"))

from cmrelay.relayextract import ShapeError, extract_all  # noqa: E402


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "relay_root",
        nargs="?",
        default=REPO / "cmdeploy-relay",
        type=Path,
        help="path to a relay checkout (default: the cmdeploy-relay submodule)",
    )
    parser.add_argument("-o", "--output", type=Path, help="write here instead of stdout")
    args = parser.parse_args(argv)

    try:
        data = extract_all(args.relay_root)
    except ShapeError as exc:
        print(f"extract-from-relay: {exc}", file=sys.stderr)
        return 1

    text = json.dumps(data, indent=2, sort_keys=True) + "\n"
    if args.output:
        args.output.write_text(text)
    else:
        sys.stdout.write(text)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
