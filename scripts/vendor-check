#!/usr/bin/env python3
"""Verify that vendor/ and the generated files match the submodule. Runs in CI.

A fresh sync into a temporary directory is compared byte for byte, so a
hand edit under vendor/, a moved submodule without a re-sync, and a relay
file the mapping does not cover all fail here.
"""

import sys
import tempfile
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO / "src"))

from cmrelay.vendoring import VendorError, refresh  # noqa: E402

GENERATED = ("vendor.lock", "nix/generated/relay-pins.json")


def files(root: Path) -> dict:
    return {str(p.relative_to(root)): p.read_bytes() for p in root.rglob("*") if p.is_file()}


def main():
    with tempfile.TemporaryDirectory() as tmp:
        fresh = Path(tmp)
        try:
            refresh(REPO, REPO / "cmdeploy-relay", fresh)
        except VendorError as exc:
            print(f"vendor-check: {exc}", file=sys.stderr)
            return 1
        want, have = files(fresh / "vendor"), files(REPO / "vendor")
        stale = [f"vendor/{n}" for n in sorted(set(want) | set(have)) if want.get(n) != have.get(n)]
        stale += [n for n in GENERATED if (fresh / n).read_bytes() != (REPO / n).read_bytes()]
    if stale:
        print("vendor-check: out of date, run scripts/vendor-sync:", file=sys.stderr)
        for name in stale:
            print(f"  {name}", file=sys.stderr)
        return 1
    print("vendor-check: vendor/ matches the relay submodule")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
