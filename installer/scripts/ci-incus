#!/bin/bash
# Sets incus up on a CI runner as chatmail/cmlxc's own lxc-test.yml does: Zabbly's stable
# packages, which bb33's runner images bring already, and a default initialisation
# the runner's user may use without sudo.
set -euo pipefail
if [ ! -e /etc/apt/sources.list.d/zabbly-incus.list ]; then
    sudo mkdir -p /etc/apt/keyrings
    sudo curl -fsSL https://pkgs.zabbly.com/key.asc -o /etc/apt/keyrings/zabbly.asc
    echo "deb [signed-by=/etc/apt/keyrings/zabbly.asc] https://pkgs.zabbly.com/incus/stable $(lsb_release -sc) main" |
        sudo tee /etc/apt/sources.list.d/zabbly-incus.list
    sudo apt-get update
    sudo apt-get install -y incus incus-client incus-base
fi
sudo systemctl stop docker.socket docker || true
sudo iptables -P FORWARD ACCEPT
sudo incus admin init --auto
sudo chmod 666 /var/lib/incus/unix.socket
sudo chown -R "$USER:$USER" ~/.config/incus
