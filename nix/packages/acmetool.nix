# acmetool 0.2.2, the exact version Debian bookworm packages as 0.2.2-1.
#
# Keeping acmetool rather than migrating to another ACME client is what lets
# cmrelay vendor all three acmetool templates and all three systemd units
# verbatim, and means a cmrelay host renews certificates exactly the way a
# cmdeploy host does. It also means the two can share /var/lib/acme in place
# during an upgrade, with no state-format skew and no re-issuance on rollback.
#
# Upstream never finished its Go modules migration, so the source tree has no
# go.mod. The two manifests beside this file are generated once and are the
# only Go artefacts in the repository:
#
#   go mod init git.devever.net/hlandau/acmetool
#   go mod edit -require=gopkg.in/alecthomas/kingpin.v2@v2.2.6
#   go mod tidy
#
# The kingpin pin is the non-obvious step: v2.4.0 renamed its module path to
# github.com/alecthomas/kingpin/v2, which no longer matches the
# gopkg.in/alecthomas/kingpin.v2 import path acmetool uses, and v2.2.6 is the
# last tag that still resolves.
#
# The path to zero Go here is to upstream this derivation to nixpkgs.

{
  lib,
  buildGoModule,
  fetchFromGitHub,
  pkg-config,
  libcap,
}:

buildGoModule {
  pname = "acmetool";
  version = "0.2.2";

  src = fetchFromGitHub {
    owner = "hlandau";
    repo = "acmetool";
    rev = "v0.2.2";
    hash = "sha256-r6lLOKmrsY/9mYUW/FRCllm217VcbMuVpB/iEybnQE4=";
  };

  postPatch = ''
    cp ${./acmetool-go.mod} go.mod
    cp ${./acmetool-go.sum} go.sum
  '';

  vendorHash = "sha256-R9yhgdzpOJfhooLSw/wRVThK8CpCxxYwViAPUqvaFn0=";
  subPackages = [ "cmd/acmetool" ];

  # acmetool drops capabilities after binding port 402, so the cgo build
  # needs libcap's headers.
  nativeBuildInputs = [ pkg-config ];
  buildInputs = [ libcap ];

  # cgo on, deliberately. A static build looks tempting, but Go without cgo
  # cannot resolve account names through NSS, and acmetool then refuses
  # relay's own unit:
  #
  #   ExecStart=... redirector --service.uid=daemon --bind=127.0.0.1:402
  #   Error in service: because this binary was built without cgo, UIDs/GIDs
  #   must be specified numerically and not as names
  #
  # Debian builds acmetool with cgo, which is why the unit works there. The
  # distribution-independence a static build buys is already provided by the
  # closure carrying its own glibc, so there is nothing to trade away.
  env.CGO_ENABLED = 1;

  # Force HTTP/1.1 for the module download. proxy.golang.org repeatedly cut
  # acmetool's module zips short mid-stream with an HTTP/2 INTERNAL_ERROR,
  # failing three of five observed CI attempts; the setting is inherited by
  # buildGoModule's fetch derivation and leaves vendorHash untouched, because
  # the module cache does not depend on the transport that fetched it.
  env.GODEBUG = "http2client=0";

  # `acmetool --version` reports "build unknown", because upstream injects
  # the version through ldflags generated by a script in its Makefile. That
  # is cosmetic: relay's status test only checks that acmetool-redirector is
  # running, and the pinned rev is what actually identifies the build.

  meta = {
    description = "ACME client (Let's Encrypt), the release Debian bookworm ships";
    license = lib.licenses.mit;
    mainProgram = "acmetool";
  };
}
